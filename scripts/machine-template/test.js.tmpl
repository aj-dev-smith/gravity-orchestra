import { describe, it, expect } from 'vitest';
import * as THREE from 'three';
import M from '../src/instruments/__KEY__/index.js';
import { fitPart, makeLane, laneAt, barLen, g, H, DT_MAX, LO, HI, MAX_LANES } from '../src/instruments/__KEY__/solve.js';
import { eventTimes, lanesByNote } from '../src/instruments/clock.js';
import { noteNum, ROLL_T } from '../src/engine.js';
import { ARM_AT as START } from '../src/transport.js';

/* __LABEL__ — its OWN honesty suite (generated by `npm run new:machine __KEY__`; CHANGE THIS with
   your mechanism). The shared contract every plugin passes — descriptor shape, voices, strikes on
   the beat, nothing before start, scrub-safe pose, bake budget — is test/inst-contract.test.js;
   this file proves what is special to YOUR machine: lands exactly on the beat, at rest at contact,
   no penetration, long gaps park, and it fits any input. */

const LEAD_IN = 2.4;                                  // main.js: the count-in (ROLL_T + ARM_AT are imported)
const beat = 60 / M.demo.bpm, P = ROLL_T + M.demo.beats * beat + 1.2;
const lanesOf = part => {
  const by = lanesByNote(eventTimes(fitPart(part).events, { rollT: ROLL_T, beat }));
  return Object.values(by).map(ev => makeLane(ev.map(e => e.t), ev.map(e => e.vel), P));
};
const demo = lanesOf(M.demo.part);
// a stress lane: a 16th-note buzz, a flam, then a long hold
const stress = [makeLane([...Array.from({ length: 16 }, (_, i) => ROLL_T + i * .15), ROLL_T + 3, ROLL_T + 3.05], [], P)];

describe('__LABEL__ — the solve is honest', () => {
  it('the marble is on its bar, and the bar at its rest height, exactly at every strike, every loop', () => {
    for (const L of [...demo, ...stress]) for (const s of L.L.s) for (const k of [0, 1, 5]){
      const a = laneAt(L, s + k * P, START);
      expect(a.ball).toBeCloseTo(0, 9);
      expect(a.head).toBeCloseTo(0, 9);
    }
  });
  it('never through the bar, never above the magnet (dense, sparse, and the count-in)', () => {
    for (const L of [...demo, ...stress]) for (let t = -LEAD_IN; t < 2 * P; t += .0013){
      const a = laneAt(L, t, START);
      expect(a.ball - a.head).toBeGreaterThanOrEqual(-1e-9);
      expect(a.ball).toBeLessThanOrEqual(H + 1e-9);
    }
  });
  it('hangs ARMED on its magnet through the count-in, then drops onto its first strike', () => {
    for (const L of demo){
      const a = laneAt(L, -LEAD_IN, START);
      expect(a.armed).toBe(true); expect(a.held).toBe(true); expect(a.ball).toBeCloseTo(H, 12);
    }
  });
  it('a gap longer than DT_MAX kisses the magnet at zero speed and holds', () => {
    let parked = 0;
    for (const L of demo) L.L.gaps.forEach((gap, i) => {
      if (gap <= DT_MAX) return;
      const a = laneAt(L, L.L.s[i] + P + DT_MAX / 2 + 1e-6, START);
      expect(a.ball).toBeCloseTo(H, 6); expect(Math.abs(a.vy)).toBeLessThan(1e-4); expect(a.held).toBe(true);
      parked++;
    });
    expect(parked, 'the demo shows a magnet park').toBeGreaterThan(0);
  });
  it('is continuous — nothing teleports (the seam, a hold, a release)', () => {
    const vMax = g * DT_MAX / 2 + 1e-6, dt = 1e-3;
    for (const L of [...demo, ...stress]) for (let t = START; t < 2 * P; t += dt)
      expect(Math.abs(laneAt(L, t + dt, START).ball - laneAt(L, t, START).ball)).toBeLessThanOrEqual(vMax * dt * 1.01);
  });
  it('a bar\'s length is a pure fn of its note: shorter = higher', () => {
    expect(barLen('C5')).toBe(barLen('C5'));
    expect(barLen('C6')).toBeLessThan(barLen('C5'));
  });
});

describe('__LABEL__ — fits ANY input, never throws', () => {
  it('drops garbage, folds strays into range, keeps the most-used pitches', () => {
    const garbage = [null, 7, [], ['x'], [1, 'H9'], [2, 'C4', 0], [NaN, 'C4'], [3, 'C#9'], [4, 'C0', .5]];
    const { events, warnings } = fitPart(garbage);
    expect(events.length).toBe(2);
    for (const e of events){ expect(noteNum(e[1])).toBeGreaterThanOrEqual(LO); expect(noteNum(e[1])).toBeLessThanOrEqual(HI); }
    expect(warnings.length).toBeGreaterThan(0);
    const many = Array.from({ length: 500 }, (_, i) => [(i * 7919 % 1600) / 100, ['C', 'D', 'E', 'F#', 'G#', 'A#'][i % 6] + (3 + i % 4), ((i * 31) % 100) / 100 + .01]);
    expect(new Set(fitPart(many).events.map(e => e[1])).size).toBeLessThanOrEqual(MAX_LANES);
    const I = M.make({ envMap: null, glowTex: null, THREE }), warn = console.warn;
    console.warn = () => {};
    try {
      for (const part of [garbage, many, [], undefined]){
        I.build(part, { rollT: ROLL_T, beat, P, start: START, floorY: 0, ceilY: 30, loopBeats: M.demo.beats });
        for (let t = -LEAD_IN; t < P; t += .1) I.update(t, P, .1, { started: true, skipStrikes: false, onStrike(){} });
      }
    } finally { console.warn = warn; }
  });
});
