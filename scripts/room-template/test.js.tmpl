import { describe, it, expect } from 'vitest';
import { CROWD, CROWD2, planOf, buildRoom } from './helpers/room-contract.js';   // (first: it installs the fake DOM rooms build under)
import { disposeTree } from '../src/rooms/common.js';
import { footingBoxes } from '../src/rooms/footing.js';
import room, { lanternSpots, litOf, MAX_LANTERNS, CLEAR } from '../src/rooms/__KEY__.js';

/* ============================================================
   __LABEL__ (src/rooms/__KEY__.js) — this room's OWN tests. The generic room contract (floor, no lights,
   props clear of the machines, a pure update, no per-frame allocation, the prewarm rules, dispose) runs
   for every room in test/room-contract.test.js — this file proves what is particular to this one.
   CROWD / CROWD2 (test/helpers/room-contract.js): a stage with every footing form, before and after an edit.
   ============================================================ */

describe('__LABEL__: the lanterns stand beside the machines, never in their way', () => {
  it('clear of every machine and every footing envelope (pads, lofts, stairs, ladders) — before and after a stage edit', () => {
    for (const crowd of [CROWD, CROWD2]){
      const plan = planOf(crowd), spots = lanternSpots(crowd, plan);
      expect(spots.length).toBeGreaterThan(4);
      expect(spots.length).toBeLessThanOrEqual(MAX_LANTERNS);
      const boxes = [...crowd.filter(a => a.box).map(a => a.box), ...footingBoxes(plan).map(e => e.box)];
      for (const s of spots) for (const b of boxes){
        const dx = Math.max(b[0] - s.x, 0, s.x - b[1]), dz = Math.max(b[4] - s.z, 0, s.z - b[5]);
        expect(Math.hypot(dx, dz), `lantern at ${s.x.toFixed(2)}, ${s.z.toFixed(2)}`).toBeGreaterThanOrEqual(CLEAR);
      }
    }
  });
  it('a pure fn of the stage: the same anchors → the same lanterns; an empty stage → none', () => {
    expect(lanternSpots(CROWD, planOf(CROWD))).toEqual(lanternSpots(CROWD, planOf(CROWD)));
    expect(lanternSpots([], planOf([]))).toEqual([]);
  });
  it('each lantern answers a machine that strikes (its slot in litOf), or none (−1)', () => {
    const lit = litOf(CROWD);
    for (const s of lanternSpots(CROWD, planOf(CROWD))) expect(s.slot === -1 || (s.slot >= 0 && s.slot < lit.length)).toBe(true);
  });
});

describe('__LABEL__: the room answers its machines', () => {
  it('a machine\'s lantern flares on its strike, fades after, and is dark in the count-in', () => {
    const { b } = buildRoom(room);
    b.place(CROWD, planOf(CROWD));
    const lit = litOf(CROWD), slot = lanternSpots(CROWD, planOf(CROWD)).find(s => s.slot >= 0).slot, a = lit[slot];
    const t0 = a.cue[0].t, at = t => { b.update(1 / 60, t, null, 0); return b.lanternLight[slot]; };
    expect(at(-2)).toBe(0);                                    // the count-in: nothing has struck yet
    expect(at(t0 + .01)).toBeGreaterThan(.9 * a.cue[0].w);     // just after the strike: lit
    expect(at(t0 + 2)).toBeLessThan(.05);                      // two seconds on: faded (decay .5 s)
    expect(at(t0 + .01)).toBe(at(t0 + .01));                   // scrub back: the same light
    disposeTree(b.group); b.dispose();
  });
});
