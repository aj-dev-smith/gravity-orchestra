/* ============================================================
   __LABEL__ — the pure math (no THREE scene, no DOM, no audio).
   Generated by `npm run new:machine __KEY__` — a WORKING starting point. Change anything.

   THE MECHANISM (the starter machine — replace it with yours):
   one marble per pitch (a LANE), and it only ever touches its OWN tone bar.
   · between two strikes the marble flies the solved vertical arc for the gap:
     v0 = g·gap/2, apex = g·gap²/8 — the closed-form solve (solveLaunch in 1-D), so it
     lands on the bar EXACTLY on the beat. Rhythm reads as bounce height.
   · a gap longer than DT_MAX parks: the marble rises to an ELECTROMAGNET hung at exactly the
     max apex H, arrives at zero speed, is held, and is released DT_MAX/2 before the next strike.
   · a real bounce is lossy (restitution E), so the bar rides a PISTON that supplies the
     difference every strike (Δv = vOut − E·vIn) — the visible energy source. It is exactly at
     its rest height at every contact.
   This is the drum machine's DRIBBLE solve (src/engine.js dribbleLane / dribbleAt /
   dribblePiston — unit-tested in test/dribble.test.js), applied to pitched bars.

   Time is the only state: every function here is a pure fn of songTime.
   ============================================================ */
import { dribbleLane, dribbleAt, dribblePiston, G, noteNum } from '../../engine.js';

export const g = -G.y;                       // |gravity| = 14.5 u/s² (the ONE gravity — never change it)
// CHANGE THIS: the feel of the machine
export const DT_MAX = .8;                    // the longest free flight (s); a longer gap parks on the magnet
export const H = g * DT_MAX * DT_MAX / 8;    // the magnet's height = the max apex (ball underside above the bar)
export const E = .6;                         // restitution: marble ↔ bar (a real bounce keeps only E of its speed)
export const KICK = .08, KICK_MAX = .3;      // the piston's stroke per unit Δv, and its travel cap (u)
export const BALL_R = .2;                    // marble radius
// CHANGE THIS: what the machine can play (your build() must FIT any input — see fitPart)
export const LO = 48, HI = 96;               // playable range (MIDI: C3 … C7); strays fold by octaves
export const MAX_LANES = 12;                 // at most this many pitches (one bar each); the rarest are dropped
export const NOTE_RE = /^[A-G]#?\d$/;        // a pitch name (sharps only: 'C4', 'F#5')

const fold = n => { while (n < LO) n += 12; while (n > HI) n -= 12; return n; };
const NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const nameOf = n => NAMES[n % 12] + (Math.floor(n / 12) - 1);

/** Fit ANY part to the machine — never throws (a MIDI import or a hand-written song may send
    garbage): drops malformed events, folds out-of-range pitches by octaves, keeps the
    MAX_LANES most-used pitches. → { events: [[beat, note, vel, dur]], warnings: [...] }.
    build() and voiceIds() BOTH call this, so the bake and the strikes can never disagree. */
export function fitPart(part){
  const warnings = [], events = [];
  let bad = 0, folded = 0;
  for (const e of Array.isArray(part) ? part : []){
    if (!Array.isArray(e)) { bad++; continue; }
    const [beat, note, vel = 1, dur = 0] = e;
    if (!Number.isFinite(beat) || typeof note !== 'string' || !NOTE_RE.test(note) || !(vel > 0)) { bad++; continue; }
    const n = noteNum(note), f = fold(n);
    if (f !== n) folded++;
    events.push([beat, nameOf(f), Math.min(1, vel), Number.isFinite(dur) ? Math.max(0, dur) : 0]);
  }
  if (bad) warnings.push(`dropped ${bad} malformed event${bad > 1 ? 's' : ''}`);
  if (folded) warnings.push(`folded ${folded} note${folded > 1 ? 's' : ''} into ${nameOf(LO)}–${nameOf(HI)}`);
  const count = new Map();
  for (const e of events) count.set(e[1], (count.get(e[1]) || 0) + 1);
  if (count.size > MAX_LANES){
    const keep = new Set([...count].sort((a, b) => b[1] - a[1] || noteNum(a[0]) - noteNum(b[0])).slice(0, MAX_LANES).map(c => c[0]));
    warnings.push(`kept the ${MAX_LANES} most-used pitches (dropped ${count.size - MAX_LANES})`);
    return { events: events.filter(e => keep.has(e[1])), warnings };
  }
  return { events, warnings };
}

/** A bar's length — a PURE FUNCTION OF ITS NOTE (never of the layout): a free bar's pitch goes
    as 1/L², so L ∝ f^−½ — an octave up is 1/√2 as long. CHANGE THIS with your geometry. */
export const barLen = note => Math.max(.7, Math.min(2.6, 1.8 * Math.pow(2, -(noteNum(note) - 72) / 24)));

/** One lane, solved ONCE at build: its strike times (loop-local s), their velocities, the loop
    period P. vel[i] belongs to the lane's i-th strike (L.s — sorted, wrapped, de-duplicated). */
export function makeLane(times, vels, P){
  const L = dribbleLane(times, P, { dtMax: DT_MAX });
  const wrap = t => ((t % P) + P) % P;                  // (the same wrap dribbleLane keys its strikes by)
  const byS = new Map();
  times.forEach((t, k) => { const s = wrap(t); byS.set(s, Math.max(byS.get(s) ?? 0, vels[k] ?? 1)); });
  return { L, vel: L.s.map(s => byS.get(s) ?? 1) };
}

/** The lane at songTime t (start = the armed instant: before the lane's first strike after it,
    the marble hangs on its magnet). Returns
      ball   height of the marble's underside above the bar's REST top (u)
      vy     its vertical speed
      head   the bar's piston offset from rest (exactly 0 at every strike)
      held   on the magnet (the coil is energised)
      armed  nothing has struck yet (the count-in)
      i, since, until, abs   the strike just left, time since it / to the next, its absolute time */
export function laneAt(lane, t, start = -Infinity){
  const tc = Math.max(t, start);                        // (dribbleAt clamps the same way)
  const d = dribbleAt(lane.L, tc, start);
  const head = dribblePiston(lane.L, tc, { e: E, k: KICK, maxA: KICK_MAX, start });
  const armed = d.i < 0;
  return { ball: d.y, vy: d.vy, head, held: d.mode === 'hold', armed, i: d.i,
           since: d.since, until: d.until, abs: armed ? -Infinity : tc - d.since };
}
