import * as THREE from 'three';
import { eventTimes, lanesByNote, makeEdge } from '../clock.js';
import { noteNum } from '../../engine.js';
import { fitPart, makeLane, laneAt, barLen, H, BALL_R, KICK_MAX } from './solve.js';
import { barVoice } from './voice.js';

/* ============================================================
   __LABEL__ — the descriptor + the render (the contract: src/instruments/README.md).
   Generated by `npm run new:machine __KEY__`. A WORKING starter: one marble per pitch
   dribbling on its own tone bar (solve.js), a piston under each bar, an electromagnet
   over each lane for the long gaps. Everything that moves is a pure fn of songTime.

   Try it:   npm run dev   →   http://localhost:5173/?solo=__KEY__&debug
   Test it:  npx vitest run test/inst-__KEY__.test.js test/inst-contract.test.js
   ============================================================ */

// CHANGE THIS: the look
const COLOR = '__COLOR__';           // the machine's signature glow (cam button, strike light, bars)
const COIL = 0x6fd0ff;               // the magnets speak ice-blue
const COLOR_HEX = new THREE.Color(COLOR).getHex();
const SP = .9;                       // lane spacing (x)
const BAR_W = .5, BAR_T = .12;       // tone bar width (x) and thickness (y); its length (z) is barLen(note)
const BAR_Y = 1.4;                   // the bars' REST top (local y; y = 0 is the deck top you stand on)
const SLAB = .3, D = 3.4;            // the deck: thickness and depth
const PUCK_H = .1;

export default {
  key: '__KEY__',                    // = the folder name = the song.parts key
  label: '__LABEL__',
  wet: true,                         // true → the voice also feeds the melody's echo
  lookHeight: 2,                     // the y the station camera aims at (local)
  camera: { dist: 10, up: 3 },       // the director's shot: eye at (x, lookHeight + up, dist), local
  color: COLOR,
  // STAGING hints for a machine with no STATIONS entry (stations.js guestSlot): its footprint, and
  // optionally its turn (yaw) and the floor SEATS it prefers, e.g. seats: ['left', 'wingL', 'centre']
  stage: { w: 12, d: 4 },

  voice: id => barVoice(id),
  // the ids to bake = exactly what build() will fire (the same fitPart)
  voiceIds: part => [...new Set(fitPart(part).events.map(e => e[1]))],
  // MIDI auto-routing is opt-in: export PART_LIMITS from solve.js, re-export it here, and add the
  // routing entries in src/midi/orchestra.js (README "PART_LIMITS"). Without it, the MAP panel can
  // still send any MIDI voice to this machine by hand (fitted as a single line).

  make({ envMap }){
    let lanes = [], start = -Infinity;

    // Rebuild everything for a song: a THREE.Group in YOUR local frame (+x across, +y up,
    // +z toward the audience, y = 0 the deck top). Main places it in the room and draws its supports.
    function build(part, { rollT, beat, P, start: s0 = -Infinity }){
      const group = new THREE.Group();
      lanes = []; start = s0;
      const { events, warnings } = fitPart(part);
      for (const w of warnings) console.warn(`[__KEY__] ${w}`);
      const byNote = lanesByNote(eventTimes(events, { rollT, beat }));
      const notes = Object.keys(byNote).sort((a, b) => noteNum(a) - noteNum(b));   // low → high, left → right
      const n = notes.length;
      if (!n) return group;

      // materials: a constant count after build (a new material mid-song = a shader compile = a dropped frame)
      const chrome = new THREE.MeshStandardMaterial({ color: 0xd8dde8, metalness: 1, roughness: .15, envMap });
      const dark = new THREE.MeshStandardMaterial({ color: 0x232733, metalness: .7, roughness: .45, envMap });
      const add = (geo, mat, x, y, z, parent = group) => { const m = new THREE.Mesh(geo, mat); m.position.set(x, y, z); parent.add(m); return m; };

      // the deck + the gantry the magnets hang from (static: main bakes still parts into one mesh per material)
      const W = Math.max(3, n * SP + 1.2), yPuck = BAR_Y + H + 2 * BALL_R, yBeam = yPuck + PUCK_H + .45;
      add(new THREE.BoxGeometry(W, SLAB, D), dark, 0, SLAB / 2, 0);
      for (const sx of [-1, 1]) add(new THREE.BoxGeometry(.22, yBeam - SLAB, .22), dark, sx * (W / 2 - .25), (SLAB + yBeam) / 2, 0);
      add(new THREE.BoxGeometry(W - .3, .18, .22), dark, 0, yBeam, 0);

      const ballGeo = new THREE.SphereGeometry(BALL_R, 24, 16);
      const housingTop = BAR_Y - BAR_T - KICK_MAX - .08, rodBot = SLAB + .25;
      const housingGeo = new THREE.CylinderGeometry(.14, .16, housingTop - SLAB, 16);
      const rodGeo = new THREE.CylinderGeometry(.06, .06, BAR_Y - BAR_T - rodBot, 12);
      const puckGeo = new THREE.CylinderGeometry(.16, .16, PUCK_H, 20);
      const coilGeo = new THREE.TorusGeometry(.17, .03, 8, 24).rotateX(Math.PI / 2);
      const dropGeo = new THREE.CylinderGeometry(.03, .03, yBeam - yPuck - PUCK_H, 8);

      notes.forEach((note, k) => {
        const ev = byNote[note], x = (k - (n - 1) / 2) * SP;
        const lane = makeLane(ev.map(e => e.t), ev.map(e => e.vel), P);
        add(housingGeo, dark, x, (SLAB + housingTop) / 2, 0);
        // the moving part: bar + piston rod, translated by the piston offset (solve.js laneAt().head)
        const piston = new THREE.Group(); piston.position.x = x; group.add(piston);
        const barM = new THREE.MeshStandardMaterial({ color: 0x8a8f9c, metalness: .9, roughness: .25, envMap,
          emissive: new THREE.Color(COLOR), emissiveIntensity: .12 });
        add(new THREE.BoxGeometry(BAR_W, BAR_T, barLen(note)), barM, 0, BAR_Y - BAR_T / 2, 0, piston);
        add(rodGeo, chrome, 0, (rodBot + BAR_Y - BAR_T) / 2, 0, piston);
        // the magnet over the lane: a drop rod, a puck (its underside kisses the held marble's top), a coil
        const coilM = new THREE.MeshStandardMaterial({ color: 0x0b1c26, emissive: new THREE.Color(COIL), emissiveIntensity: .1 });
        add(dropGeo, dark, x, (yPuck + PUCK_H + yBeam) / 2, 0);
        add(puckGeo, chrome, x, yPuck + PUCK_H / 2, 0);
        add(coilGeo, coilM, x, yPuck + PUCK_H / 2, 0);
        const ball = add(ballGeo, chrome, x, 0, 0);
        lanes.push({ note, lane, x, piston, barM, coilM, ball, edge: makeEdge(.25),
                     contact: new THREE.Vector3(x, BAR_Y, 0) });
      });
      return group;
    }

    // Per frame — a PURE fn of songTime (?debug can scrub anywhere). Not started → the ARMED pose
    // at t = start. Each strike fires ONCE (makeEdge; skipStrikes swallows a scrub jump).
    function update(songTime, P, dt, { started, skipStrikes, onStrike }){
      const t = started ? songTime : start;
      for (const ln of lanes){
        const s = laneAt(ln.lane, t, start);
        const vel = s.armed ? 0 : ln.lane.vel[s.i];
        if (started && !s.armed && ln.edge.check(s.abs, s.since, skipStrikes))
          onStrike?.({ note: ln.note, vel, pos: ln.contact.clone(), color: COLOR_HEX, dur: 0,
            shake: 0, sparks: Math.round(3 + 6 * vel), light: .8 + .6 * vel });
        ln.piston.position.y = s.head;
        ln.ball.position.y = BAR_Y + BALL_R + s.ball;
        // light as a pure fn of time-since: the bar flashes on the hit and cools; the coil burns while it holds
        ln.barM.emissiveIntensity = .12 + (s.armed ? 0 : 2.4 * vel * Math.exp(-s.since * 7));
        ln.coilM.emissiveIntensity = s.held ? 1.6 : .1;
      }
    }

    return { build, update };
  },

  // The ?solo demo: a part on a minimal melodic spine (beats: a multiple of 4). CHANGE THIS.
  // It shows every path: single hits, a chord, a fast repeat, and long gaps that park on the magnet.
  demo: {
    bpm: 100, beats: 16,
    part: [
      [0, 'C5', .9], [1, 'E5', .7], [2, 'G5', .8], [3, 'C6', 1],
      [4, 'B5', .6], [4.5, 'G5', .5], [5, 'E5', .6], [6, 'D5', .7],
      [8, 'C5', .9], [8, 'E5', .7], [8, 'G5', .7],
      [10, 'A5', .6], [10.5, 'A5', .5], [11, 'A5', .7], [12, 'G5', .8], [14, 'C5', 1],
    ],
  },
};
