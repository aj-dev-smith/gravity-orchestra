{
  "name": "cascade",
  "version": "1.0.0",
  "description": "Cascade — melody-driven marble run. The melody is authored first; the physics is solved backward from it.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:xr": "vite --mode xr",
    "build": "vite build",
    "build:single": "vite build --mode single && cp dist-single/index.html marble-cascade.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && ./deploy.sh"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "iwer": "^2.5.0",
    "puppeteer-core": "^25.12.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.0"
  }
}
